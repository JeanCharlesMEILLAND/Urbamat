generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Realisation {
  id            String @id @default(cuid())
  titre         String
  ville         String
  departement   String
  annee         Int
  typologieQuai String
  contexte      String
  longueurMl    Float
  nbStations    Int
  slug          String @unique

  @@map("realisations")
}

model Document {
  id          String       @id @default(cuid())
  titre       String
  type        DocumentType
  fichierUrl  String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("documents")
}

model Lead {
  id                   String     @id @default(cuid())
  prenom               String
  nom                  String
  societe              String
  email                String
  profil               ProfilType
  departement          String
  message              String?
  documentsTelecharges String[]
  createdAt            DateTime   @default(now())

  @@map("leads")
}

model Stat {
  id     String @id @default(cuid())
  label  String
  valeur String
  ordre  Int

  @@map("stats")
}

model Parametres {
  id           String @id @default("singleton")
  nomSite      String @default("URBAQUAI")
  emailContact String @default("contact@urbamat.fr")
  tel          String @default("")
  adresse      String @default("")
  linkedin     String @default("")

  @@map("parametres")
}

model ArticleReglementation {
  id        String   @id @default(cuid())
  titre     String
  slug      String   @unique
  contenu   String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles_reglementation")
}

// ─── Contenus éditables (CMS léger) ─────────────────────────────

model PageContent {
  id        String      @id @default(cuid())
  page      String      // "home", "produit", "contact", etc.
  section   String      // "hero_titre", "hero_description", etc.
  contenu   String
  type      ContentType @default(texte)
  ordre     Int         @default(0)
  updatedAt DateTime    @updatedAt

  @@unique([page, section])
  @@map("page_contents")
}

enum ContentType {
  texte
  html
  image
  lien
}

// ─── Sessions admin ──────────────────────────────────────────────

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("admin_sessions")
}

enum DocumentType {
  fiche
  guide
  cctp
  plan
}

enum ProfilType {
  moe
  moa
  tp
  collectivite
  autre
}
